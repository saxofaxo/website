{
  // SAXOFAXO auf Cloudflare: Worker mit statischen Assets
  // Deploy: npx wrangler deploy   (nach `wrangler login` und KV-Setup, siehe GO-LIVE.md)
  "name": "saxofaxo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Alles laeuft zuerst durch den Worker: noetig fuer www->Apex-Redirect
    // und damit Navigations-POSTs an /api/* nicht im Assets-Layer landen.
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "cc939284186c485a93b670419348d211" },
    { "binding": "STATS", "id": "451488eca9a1433fbca8830266bb6afb" }
  ],
  "vars": {
    // Erlaubte Frontend-Hostnames fuer die Turnstile-Siteverify-Pruefung
    // (Produktions-Allowlist – niemals localhost hier eintragen)
    "TURNSTILE_HOSTNAMES": "saxofaxo.com,www.saxofaxo.com,saxofaxo.toennies-felix.workers.dev"
  },
  "routes": [
    { "pattern": "saxofaxo.com", "custom_domain": true },
    { "pattern": "www.saxofaxo.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
  // Secrets (nicht hier, sondern per CLI):
  //   npx wrangler secret put ADMIN_PASSWORD
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
}
